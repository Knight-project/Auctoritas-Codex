<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/schedule"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".scheduleFragment">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:isScrollContainer="true">



            <com.google.android.material.card.MaterialCardView
                android:id="@+id/title_card"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_margin="0dp"
                android:background="@color/white"
                android:textAlignment="center"
                app:cardCornerRadius="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/white">

                <android.widget.TextView
                    android:background="@color/white"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/franchise"
                    android:gravity="center"
                    android:text="SCHEDULES"
                    android:textAlignment="center"
                    android:textColor="@color/g5"
                    android:textSize="80dp"
                    android:typeface="monospace"
                    android:letterSpacing="0.08"/>


            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/routine_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                app:cardCornerRadius="0dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/title_card"
                tools:layout_editor_absoluteX="15dp"
                app:strokeColor="@color/white">

                <com.github.chrisbanes.photoview.PhotoView
                    android:id="@+id/routine_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/calender_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="20dp"
                android:outlineAmbientShadowColor="@color/g1"
                android:outlineSpotShadowColor="@color/g1"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@+id/routine_card"
                app:strokeColor="@color/white">

                <com.github.chrisbanes.photoview.PhotoView
                    android:id="@+id/calender_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/site_btn"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.45"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_height="225dp"
                android:layout_marginTop="30dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/g5"
                android:textAlignment="center"
                app:cardCornerRadius="18dp"
                app:cardElevation="5dp"
                app:layout_constraintTop_toBottomOf="@+id/calender_card">

                <ImageView
                    android:contentDescription="Go to site"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:tint="@color/white"
                    android:src="@drawable/main_component_svgrepo_com"
                    android:layout_gravity="center"/>
<!--                <android.widget.TextView-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:fontFamily="@font/ossan_reg"-->
<!--                    android:gravity="center"-->
<!--                    android:text="GO TO SITE"-->
<!--                    android:textAlignment="center"-->
<!--                    android:textColor="@color/white"-->
<!--                    android:textSize="35dp"-->
<!--                    android:typeface="monospace" />-->
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/app_download_btn"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.45"
                android:layout_height="104dp"
                android:layout_marginTop="30dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/g4"
                android:textAlignment="center"
                app:cardCornerRadius="18dp"
                app:cardElevation="5dp"
                app:layout_constraintTop_toBottomOf="@+id/calender_card"
                app:layout_constraintRight_toRightOf="parent">
                <ImageView
                    android:contentDescription="Download the latest version"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:tint="@color/white"
                    android:src="@drawable/download_offline_svgrepo_com"
                    android:layout_gravity="center"/>

<!--                <android.widget.TextView-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:fontFamily="@font/ossan_reg"-->
