<!--                    android:text="DOWNLOAD UPDATE"-->
<!--                    android:textAlignment="center"-->
<!--                    android:textColor="#FFFFFF"-->
<!--                    android:textSize="35dp"-->
<!--                    android:typeface="monospace" />-->
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/brain_quarry_btn"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.45"
                android:layout_height="104dp"
                android:layout_margin="12dp"
                android:backgroundTint="@color/g3"
                android:textAlignment="center"
                app:cardCornerRadius="18dp"
                app:cardElevation="5dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/app_download_btn">
                <ImageView
                    android:contentDescription="Go to site"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:tint="@color/white"
                    android:src="@drawable/books_svgrepo_com"
                    android:layout_gravity="center"/>

<!--                <android.widget.TextView-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:fontFamily="@font/ossan_reg"-->
<!--                    android:gravity="center"-->
<!--                    android:text="BRAIN QUARRY"-->
<!--                    android:textAlignment="center"-->
<!--                    android:textColor="#FFFFFF"-->
<!--                    android:textSize="35dp"-->
<!--                    android:typeface="monospace"/>-->
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/discord_btn"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.45"
                android:layout_height="225dp"
                android:layout_margin="12dp"
                android:backgroundTint="@color/g5"
                android:textAlignment="center"
                app:cardCornerRadius="18dp"
                app:cardElevation="5dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/brain_quarry_btn">
                <ImageView
                    android:contentDescription="Go to StrategicMind Discord Server"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:tint="@color/white"
                    android:src="@drawable/discord_svgrepo_com"
                    android:layout_gravity="center"/>

<!--                <android.widget.TextView-->
<!--                    android:id="@+id/discord_btn_title"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:fontFamily="@font/ossan_reg"-->
<!--                    android:gravity="center"-->
<!--                    android:text="DISCORD"-->
<!--                    android:textAlignment="center"-->
<!--                    android:textColor="#FFFFFF"-->
<!--                    android:textSize="35dp"-->
<!--                    android:typeface="monospace" />-->
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/telegram_btn"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.45"
                android:layout_height="104dp"
                android:layout_margin="12dp"
                android:backgroundTint="@color/g3"
                android:textAlignment="center"
                app:cardCornerRadius="18dp"
                app:cardElevation="5dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/site_btn">
                <ImageView
                    android:contentDescription="Go to telegram channel"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:tint="@color/white"
                    android:src="@drawable/telegram_svgrepo_com"
                    android:layout_gravity="center"/>

<!--                <android.widget.TextView-->
<!--                    android:id="@+id/telegram_btn_title"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:fontFamily="@font/ossan_reg"-->
<!--                    android:gravity="center"-->
<!--                    android:text="TELEGRAM"-->
<!--                    android:textAlignment="center"-->
<!--                    android:textColor="#FFFFFF"-->
<!--                    android:textSize="35dp"-->
<!--                    android:typeface="monospace" />-->
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/github_btn"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.45"
                android:layout_height="104dp"
                android:layout_margin="12dp"
                android:backgroundTint="@color/g4"
                android:textAlignment="center"
                app:cardCornerRadius="18dp"
                app:cardElevation="5dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/telegram_btn">
                <ImageView
                    android:contentDescription="Go to github page"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:tint="@color/white"
                    android:src="@drawable/github_142_svgrepo_com"
                    android:layout_gravity="center"/>

<!--                <android.widget.TextView-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:fontFamily="@font/ossan_reg"-->
